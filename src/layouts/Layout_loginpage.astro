---
import '../styles/global.css';
import Header from '../components/Header_loginpage.astro';
const { titre } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Ordaily - {titre}</title>
  </head>

  <body class="relative min-h-screen overflow-x-hidden bg-pure-white">
    <Header />
    <slot />
  </body>
</html>

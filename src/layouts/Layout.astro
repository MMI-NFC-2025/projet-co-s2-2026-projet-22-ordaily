---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'
const { titre } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{titre}</title>
  </head>

  <body class="relative min-h-screen overflow-x-hidden bg-pure-white">
    <Header />

    <div class="absolute inset-0 -z-10 overflow-hidden">
      <img
        src="/images/ordaily_waves.svg"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute -mt-14 left-1/2 top-14 w-[80vw] max-w-none translate-x-[20%] select-none min-[400px]:top-16 lg:top-20 lg:w-[80rem] lg:-translate-y-[20%] lg:translate-x-[2%]"
      />
    </div>

    <main class="relative z-10">
      <slot />
    </main>
	<Footer />
  </body>
</html>

---
import Layout from '../layouts/Layout_without_wave.astro';
---

<Layout titre="Contact">

  <div class="px-6 pt-10 mb-16">

    <!-- Titre + illustration -->
    <h1 class="font-plus-jakarta-sans text-2xl font-bold text-[var(--color-void-black)] mb-8">Contact</h1>

    <!-- Légende -->
    <p class="font-manrope text-xs text-[var(--color-void-black)]/40 mb-6"><span class="text-red-400">*</span> Champs obligatoires</p>

    <!-- Formulaire -->
    <div class="flex flex-col gap-5">

      <!-- Prénom -->
      <div class="flex flex-col gap-1.5">
        <label class="font-manrope text-xs font-semibold text-[var(--color-void-black)]/60">Prénom <span class="text-red-400">*</span></label>
        <input
          id="prenom"
          type="text"
          placeholder="ex : Lucas"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="err-prenom" class="hidden font-manrope text-xs text-red-400 pl-2">Veuillez entrer votre prénom.</p>
      </div>

      <!-- Nom -->
      <div class="flex flex-col gap-1.5">
        <label class="font-manrope text-xs font-semibold text-[var(--color-void-black)]/60">Nom <span class="text-red-400">*</span></label>
        <input
          id="nom"
          type="text"
          placeholder="ex : Martin"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="err-nom" class="hidden font-manrope text-xs text-red-400 pl-2">Veuillez entrer votre nom.</p>
      </div>

      <!-- Mail -->
      <div class="flex flex-col gap-1.5">
        <label class="font-manrope text-xs font-semibold text-[var(--color-void-black)]/60">Adresse email <span class="text-red-400">*</span></label>
        <input
          id="mail"
          type="email"
          placeholder="ex : lucas.martin@email.com"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="err-mail" class="hidden font-manrope text-xs text-red-400 pl-2">Veuillez entrer une adresse email valide.</p>
      </div>

      <!-- Objet -->
      <div class="flex flex-col gap-1.5">
        <label class="font-manrope text-xs font-semibold text-[var(--color-void-black)]/60">Objet <span class="text-red-400">*</span></label>
        <input
          id="objet"
          type="text"
          placeholder="ex : Question sur le logement"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="err-objet" class="hidden font-manrope text-xs text-red-400 pl-2">Veuillez entrer un objet.</p>
      </div>

      <!-- Message -->
      <div class="flex flex-col gap-1.5">
        <label class="font-manrope text-xs font-semibold text-[var(--color-void-black)]/60">Message <span class="text-red-400">*</span></label>
        <textarea
          id="message"
          placeholder="ex : Bonjour, j'aurais une question concernant..."
          rows="6"
          class="w-full rounded-2xl border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-4 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors resize-none"
        ></textarea>
        <p id="err-message" class="hidden font-manrope text-xs text-red-400 pl-2">Veuillez entrer un message.</p>
      </div>

      <p id="feedback" class="hidden text-center text-sm font-manrope font-semibold"></p>

      <button
        id="btn-envoyer"
        type="button"
        class="w-full rounded-full bg-[#F5A623] px-6 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-white hover:opacity-80 transition-opacity disabled:opacity-40 mt-2"
      >
        Envoyer
      </button>

    </div>

  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('http://127.0.0.1:8090');

  const btn = document.getElementById('btn-envoyer');
  const feedback = document.getElementById('feedback');

  const champs = ['prenom', 'nom', 'mail', 'objet', 'message'];

  function resetErrors() {
    champs.forEach(id => {
      document.getElementById(`err-${id}`).classList.add('hidden');
      document.getElementById(id).style.borderColor = '';
    });
  }

  function showError(id) {
    document.getElementById(`err-${id}`).classList.remove('hidden');
    document.getElementById(id).style.borderColor = '#f87171';
  }

  btn.addEventListener('click', async () => {
    resetErrors();
    feedback.classList.add('hidden');

    const prenom = document.getElementById('prenom').value.trim();
    const nom = document.getElementById('nom').value.trim();
    const mail = document.getElementById('mail').value.trim();
    const objet = document.getElementById('objet').value.trim();
    const message = document.getElementById('message').value.trim();

    let hasError = false;

    if (!prenom) { showError('prenom'); hasError = true; }
    if (!nom) { showError('nom'); hasError = true; }
    if (!mail || !mail.includes('@')) { showError('mail'); hasError = true; }
    if (!objet) { showError('objet'); hasError = true; }
    if (!message) { showError('message'); hasError = true; }

    if (hasError) return;

    btn.disabled = true;
    btn.textContent = 'Envoi...';

    try {
      await pb.collection('contactform').create({ prenom, nom, mail, objet, message });

      feedback.textContent = '✓ Message envoyé, merci !';
      feedback.className = 'text-center text-sm font-manrope font-semibold text-green-500';
      feedback.classList.remove('hidden');

      champs.forEach(id => { document.getElementById(id).value = ''; });

    } catch (e) {
      feedback.textContent = 'Une erreur est survenue, réessaie.';
      feedback.className = 'text-center text-sm font-manrope font-semibold text-red-500';
      feedback.classList.remove('hidden');
    }

    btn.disabled = false;
    btn.textContent = 'Envoyer';
  });
</script>
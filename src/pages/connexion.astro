---
import Layout from '../layouts/Layout_loginpage.astro';
---

<Layout titre="Se connecter">

  <div class="flex min-h-screen items-start justify-center bg-[var(--color-pure-white)] px-6 pt-12 pb-16">
    <div class="w-full max-w-sm">

      <!-- Tabs -->
      <div class="flex mb-10">
        <a href="/inscription" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-void-black)] border-b-2 border-transparent hover:border-[var(--color-void-black)] transition-colors">
          Inscription
        </a>
        <a href="/connexion" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-nebula-blue-1)] border-b-2 border-[var(--color-nebula-blue-1)]">
          Connexion
        </a>
      </div>

      <!-- Fields -->
      <div class="flex flex-col gap-4">
        <input
          id="email"
          type="email"
          placeholder="Mail"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <input
          id="password"
          type="password"
          placeholder="Mot de passe"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="error-msg" class="hidden text-center text-sm text-red-500 font-manrope"></p>
      </div>

      <!-- Submit -->
      <div class="mt-10 flex justify-center">
        <button
          id="btn-connexion"
          type="button"
          class="rounded-full bg-[var(--color-void-black)] px-12 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-pure-white)] hover:opacity-80 transition-opacity disabled:opacity-40"
        >
          Se connecter
        </button>
      </div>

    </div>
  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('https://pb-ordaily.nathan-batista-balanche.fr');

  const btn = document.getElementById('btn-connexion');
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const errorMsg = document.getElementById('error-msg');

  btn.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !password) {
      errorMsg.textContent = 'Veuillez remplir tous les champs.';
      errorMsg.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Connexion...';
    errorMsg.classList.add('hidden');

    try {
      await pb.collection('users').authWithPassword(email, password);
      window.location.href = '/home';
    } catch (e) {
      errorMsg.textContent = 'Email ou mot de passe incorrect.';
      errorMsg.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Se connecter';
    }
  });
</script>
---
import Layout from '../layouts/Layout_loginpage.astro';
---

<Layout titre="S'inscrire">

  <div class="flex min-h-screen items-start justify-center bg-[var(--color-pure-white)] px-6 pt-12 pb-16">
    <div class="w-full max-w-sm">

      <!-- Tabs -->
      <nav aria-label="Navigation inscription et connexion">
        <div class="flex mb-10" role="tablist">
          <a href="/inscription" role="tab" aria-selected="true" aria-current="page" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-nebula-blue-1)] border-b-2 border-[var(--color-nebula-blue-1)]">
            Inscription
          </a>
          <a href="/connexion" role="tab" aria-selected="false" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-void-black)] border-b-2 border-transparent hover:border-[var(--color-void-black)] transition-colors">
            Connexion
          </a>
        </div>
      </nav>

      <!-- Fields -->
      <form class="flex flex-col gap-4" aria-label="Formulaire d'inscription" onsubmit="return false;">

        <label for="prenom" class="sr-only">Prénom</label>
        <input
          id="prenom"
          type="text"
          placeholder="Prénom"
          autocomplete="given-name"
          aria-required="true"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />

        <label for="nom" class="sr-only">Nom</label>
        <input
          id="nom"
          type="text"
          placeholder="Nom"
          autocomplete="family-name"
          aria-required="true"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />

        <label for="email" class="sr-only">Adresse e-mail</label>
        <input
          id="email"
          type="email"
          placeholder="Mail"
          autocomplete="email"
          aria-required="true"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />

        <label for="password" class="sr-only">Mot de passe</label>
        <input
          id="password"
          type="password"
          placeholder="Mot de passe"
          autocomplete="new-password"
          aria-required="true"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />

        <label for="password-confirm" class="sr-only">Confirmation du mot de passe</label>
        <input
          id="password-confirm"
          type="password"
          placeholder="Confirmation du mot de passe"
          autocomplete="new-password"
          aria-required="true"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />

        <p id="error-msg" class="hidden text-center text-sm text-red-500 font-manrope" role="alert" aria-live="assertive"></p>

        <!-- Submit -->
        <div class="mt-10 flex justify-center">
          <button
            id="btn-inscription"
            type="submit"
            aria-label="Créer mon compte OrDaily"
            class="rounded-full bg-[var(--color-void-black)] px-12 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-pure-white)] hover:opacity-80 transition-opacity disabled:opacity-40"
          >
            Inscription
          </button>
        </div>

      </form>

    </div>
  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('https://pb-ordaily.nathan-batista-balanche.fr');

  const btn = document.getElementById('btn-inscription');
  const errorMsg = document.getElementById('error-msg');
  const inputs = ['prenom', 'nom', 'email', 'password', 'password-confirm'];

  function clearErrors() {
    inputs.forEach(id => document.getElementById(id).removeAttribute('aria-invalid'));
    errorMsg.classList.add('hidden');
  }

  function setError(msg, invalidIds = []) {
    errorMsg.textContent = msg;
    errorMsg.classList.remove('hidden');
    invalidIds.forEach(id => document.getElementById(id).setAttribute('aria-invalid', 'true'));
  }

  btn.addEventListener('click', async () => {
    const prenom = document.getElementById('prenom').value.trim();
    const nom = document.getElementById('nom').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const passwordConfirm = document.getElementById('password-confirm').value;

    clearErrors();

    if (!prenom || !nom || !email || !password || !passwordConfirm) {
      setError('Veuillez remplir tous les champs.', inputs);
      return;
    }

    if (password !== passwordConfirm) {
      setError('Les mots de passe ne correspondent pas.', ['password', 'password-confirm']);
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Inscription...';
    btn.setAttribute('aria-busy', 'true');

    try {
      await pb.collection('users').create({
        prenom,
        nom,
        email,
        password,
        passwordConfirm,
        avancee_budget: 0,
        avancee_logement: 0,
        avancee_administratif: 0,
        avancee_organisation: 0,
        avancee_sante: 0,
      });

      await pb.collection('users').authWithPassword(email, password);
      window.location.href = '/home';

    } catch (e) {
      const msg = e?.response?.data;
      if (msg?.email) {
        setError('Cet email est déjà utilisé.', ['email']);
      } else {
        setError('Une erreur est survenue, réessaie.');
      }
      btn.disabled = false;
      btn.textContent = 'Inscription';
      btn.removeAttribute('aria-busy');
    }
  });
</script>
---
import Layout from '../layouts/Layout_loginpage.astro';
---

<Layout titre="S'inscrire">

  <div class="flex min-h-screen items-start justify-center bg-[var(--color-pure-white)] px-6 pt-12 pb-16">
    <div class="w-full max-w-sm">

      <!-- Tabs -->
      <div class="flex mb-10">
        <a href="/inscription" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-nebula-blue-1)] border-b-2 border-[var(--color-nebula-blue-1)]">
          Inscription
        </a>
        <a href="/connexion" class="flex-1 text-center pb-3 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-void-black)] border-b-2 border-transparent hover:border-[var(--color-void-black)] transition-colors">
          Connexion
        </a>
      </div>

      <!-- Fields -->
      <div class="flex flex-col gap-4">
        <input
          id="prenom"
          type="text"
          placeholder="Prénom"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <input
          id="nom"
          type="text"
          placeholder="Nom"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <input
          id="email"
          type="email"
          placeholder="Mail"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <input
          id="password"
          type="password"
          placeholder="Mot de passe"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <input
          id="password-confirm"
          type="password"
          placeholder="Confirmation du mot de passe"
          class="w-full rounded-full border border-[var(--color-void-black)]/20 bg-[var(--color-pure-white)] px-5 py-3.5 font-manrope text-sm text-[var(--color-void-black)] placeholder:text-[var(--color-void-black)]/40 outline-none focus:border-[var(--color-nebula-blue-1)] transition-colors"
        />
        <p id="error-msg" class="hidden text-center text-sm text-red-500 font-manrope"></p>
      </div>

      <!-- Submit -->
      <div class="mt-10 flex justify-center">
        <button
          id="btn-inscription"
          type="button"
          class="rounded-full bg-[var(--color-void-black)] px-12 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-pure-white)] hover:opacity-80 transition-opacity disabled:opacity-40"
        >
          Inscription
        </button>
      </div>

    </div>
  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('http://127.0.0.1:8090');

  const btn = document.getElementById('btn-inscription');
  const errorMsg = document.getElementById('error-msg');

  btn.addEventListener('click', async () => {
    const prenom = document.getElementById('prenom').value.trim();
    const nom = document.getElementById('nom').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const passwordConfirm = document.getElementById('password-confirm').value;

    if (!prenom || !nom || !email || !password || !passwordConfirm) {
      errorMsg.textContent = 'Veuillez remplir tous les champs.';
      errorMsg.classList.remove('hidden');
      return;
    }

    if (password !== passwordConfirm) {
      errorMsg.textContent = 'Les mots de passe ne correspondent pas.';
      errorMsg.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Inscription...';
    errorMsg.classList.add('hidden');

    try {
      await pb.collection('users').create({
        prenom,
        nom,
        email,
        password,
        passwordConfirm,
        avancee_budget: 0,
        avancee_logement: 0,
        avancee_administratif: 0,
        avancee_organisation: 0,
        avancee_sante: 0,
      });

      await pb.collection('users').authWithPassword(email, password);
      window.location.href = '/home';

    } catch (e) {
      const msg = e?.response?.data;
      if (msg?.email) {
        errorMsg.textContent = 'Cet email est déjà utilisé.';
      } else {
        errorMsg.textContent = 'Une erreur est survenue, réessaie.';
      }
      errorMsg.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Inscription';
    }
  });
</script>
---
import Layout from '../../../layouts/Layout.astro';
---

<Layout titre="Budget">

  <div class="px-6 pt-10 mb-16">
    <h1 class="font-plus-jakarta-sans text-2xl font-bold text-[var(--color-void-black)] mb-8">Budget</h1>

    <div id="liste-cours" class="flex flex-col gap-3">
      <p id="loading" class="font-manrope text-sm text-[var(--color-void-black)]/40">Chargement...</p>
    </div>
  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('https://pb-ordaily.nathan-batista-balanche.fr');

  if (!pb.authStore.isValid) {
    window.location.href = '/connexion';
  }

  await pb.collection('users').authRefresh();

  const user = pb.authStore.record;
  const avancee = user.avancee_budget ?? 0;

  const cours = await pb.collection('cours_budget').getFullList({
    sort: 'numero',
  });

  const liste = document.getElementById('liste-cours');
  document.getElementById('loading').remove();

  cours.forEach((c) => {
    if (c.numero > Math.min(avancee + 1, 20)) return;

    const fait = c.numero <= avancee;

    const el = document.createElement('a');
    el.href = `/home/budget/${c.numero}`;

    el.className = `rounded-2xl border px-5 py-4 transition-colors ${
      fait
        ? 'bg-white border-gray-200 hover:border-blue-400'
        : 'bg-gray-100 border-transparent hover:border-gray-300'
    }`;

    el.innerHTML = `
      <div class="flex items-center gap-2 mb-2">
        ${fait
          ? `<img src="/icons/check_icon.svg" alt="Fait" class="w-5 h-5 shrink-0" />`
          : `<div class="w-5 h-5 shrink-0 rounded-sm border-2 border-gray-300"></div>`
        }
        <span class="font-plus-jakarta-sans text-sm font-bold ${fait ? 'text-[var(--color-void-black)]' : 'text-gray-400'}">
          ${c.numero} - ${c.titre}
        </span>
      </div>
      <p class="font-manrope text-sm ${fait ? 'text-[var(--color-void-black)]/70' : 'text-gray-400'} leading-relaxed pl-7">
        ${c.paragraphe_1}
      </p>
    `;

    liste.appendChild(el);
  });
</script>
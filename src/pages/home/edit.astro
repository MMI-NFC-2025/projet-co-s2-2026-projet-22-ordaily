---
import Layout from '../../layouts/Layout.astro';
---

<Layout titre="Modifier mes informations">

  <div class="px-6 pt-10 mb-16">

    <h1 class="font-plus-jakarta-sans text-2xl font-bold text-[var(--color-void-black)] mb-8">Mes informations</h1>

    <div class="flex flex-col gap-4">

      <!-- Prénom -->
      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
        <p class="font-manrope text-xs text-[var(--color-void-black)]/40 mb-1">Prénom</p>
        <p id="display-prenom" class="font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)]">—</p>
        <input id="input-prenom" type="text" class="hidden w-full font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)] outline-none border-b border-gray-200 pb-1 bg-transparent" />
      </div>

      <!-- Nom -->
      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
        <p class="font-manrope text-xs text-[var(--color-void-black)]/40 mb-1">Nom</p>
        <p id="display-nom" class="font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)]">—</p>
        <input id="input-nom" type="text" class="hidden w-full font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)] outline-none border-b border-gray-200 pb-1 bg-transparent" />
      </div>

      <!-- Email -->
      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
        <p class="font-manrope text-xs text-[var(--color-void-black)]/40 mb-1">Email</p>
        <p id="display-email" class="font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)]">—</p>
        <input id="input-email" type="email" class="hidden w-full font-plus-jakarta-sans text-sm font-bold text-[var(--color-void-black)] outline-none border-b border-gray-200 pb-1 bg-transparent" />
      </div>

    </div>

    <!-- Feedback -->
    <p id="feedback" class="hidden text-center text-sm font-manrope font-semibold mt-4"></p>

    <!-- Boutons -->
    <div class="mt-8 flex flex-col gap-3">
      <button
        id="btn-modifier"
        class="w-full rounded-full bg-[var(--color-void-black)] px-6 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-white hover:opacity-80 transition-opacity"
      >
        Modifier
      </button>
      <button
        id="btn-valider"
        class="hidden w-full rounded-full bg-[#F5A623] px-6 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-white hover:opacity-80 transition-opacity"
      >
        Valider
      </button>
      <button
        id="btn-annuler"
        class="hidden w-full rounded-full border border-gray-200 bg-white px-6 py-3.5 font-plus-jakarta-sans text-sm font-bold uppercase tracking-widest text-[var(--color-void-black)] hover:border-gray-400 transition-colors"
      >
        Annuler
      </button>
    </div>

  </div>

</Layout>

<script>
  import PocketBase from 'pocketbase';

  const pb = new PocketBase('http://127.0.0.1:8090');

  if (!pb.authStore.isValid) {
    window.location.href = '/connexion';
  }

  await pb.collection('users').authRefresh();
  const user = pb.authStore.record;

  function masquer(str) {
    if (!str || str.length === 0) return '—';
    return str[0] + '*'.repeat(Math.max(str.length - 1, 6));
  }

  document.getElementById('display-prenom').textContent = user.prenom ?? '—';
  document.getElementById('display-nom').textContent = user.nom ?? '—';
  document.getElementById('display-email').textContent = masquer(user.email);

  document.getElementById('input-prenom').value = user.prenom ?? '';
  document.getElementById('input-nom').value = user.nom ?? '';
  document.getElementById('input-email').value = user.email ?? '';

  const btnModifier = document.getElementById('btn-modifier');
  const btnValider = document.getElementById('btn-valider');
  const btnAnnuler = document.getElementById('btn-annuler');
  const feedback = document.getElementById('feedback');

  const displays = ['prenom', 'nom', 'email'];
  const inputs = ['prenom', 'nom', 'email'];

  btnModifier.addEventListener('click', () => {
    displays.forEach(k => document.getElementById(`display-${k}`).classList.add('hidden'));
    inputs.forEach(k => document.getElementById(`input-${k}`).classList.remove('hidden'));
    btnModifier.classList.add('hidden');
    btnValider.classList.remove('hidden');
    btnAnnuler.classList.remove('hidden');
  });

  btnAnnuler.addEventListener('click', () => {
    displays.forEach(k => document.getElementById(`display-${k}`).classList.remove('hidden'));
    inputs.forEach(k => document.getElementById(`input-${k}`).classList.add('hidden'));
    btnModifier.classList.remove('hidden');
    btnValider.classList.add('hidden');
    btnAnnuler.classList.add('hidden');
    feedback.classList.add('hidden');
  });

  btnValider.addEventListener('click', async () => {
    const prenom = document.getElementById('input-prenom').value.trim();
    const nom = document.getElementById('input-nom').value.trim();
    const email = document.getElementById('input-email').value.trim();

    if (!prenom || !nom || !email) {
      feedback.textContent = 'Tous les champs sont requis.';
      feedback.className = 'text-center text-sm font-manrope font-semibold text-red-500';
      feedback.classList.remove('hidden');
      return;
    }

    btnValider.disabled = true;
    btnValider.textContent = 'Enregistrement...';

    try {
      await pb.collection('users').update(user.id, { prenom, nom, email });
      await pb.collection('users').authRefresh();
      const updatedUser = pb.authStore.record;

      document.getElementById('display-prenom').textContent = updatedUser.prenom ?? '—';
      document.getElementById('display-nom').textContent = updatedUser.nom ?? '—';
      document.getElementById('display-email').textContent = masquer(updatedUser.email);

      displays.forEach(k => document.getElementById(`display-${k}`).classList.remove('hidden'));
      inputs.forEach(k => document.getElementById(`input-${k}`).classList.add('hidden'));
      btnModifier.classList.remove('hidden');
      btnValider.classList.add('hidden');
      btnAnnuler.classList.add('hidden');

      feedback.textContent = '✓ Informations mises à jour !';
      feedback.className = 'text-center text-sm font-manrope font-semibold text-green-500';
      feedback.classList.remove('hidden');
      setTimeout(() => feedback.classList.add('hidden'), 3000);

    } catch (e) {
      feedback.textContent = 'Une erreur est survenue, réessaie.';
      feedback.className = 'text-center text-sm font-manrope font-semibold text-red-500';
      feedback.classList.remove('hidden');
    }

    btnValider.disabled = false;
    btnValider.textContent = 'Valider';
  });
</script>